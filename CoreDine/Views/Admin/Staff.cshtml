@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Staff";
}

<div class="cd-page-header">
    <div>
        <h1>Staff Accounts</h1>
        <p>@Model.Count() staff members</p>
    </div>
    <a asp-action="CreateStaff" class="btn-primary">+ Add Staff</a>
</div>

<div class="cd-table-wrap">
    <table class="cd-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Username</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td><span class="badge-served">Active</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
