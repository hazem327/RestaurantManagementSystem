@model CoreDine.Models.Category
@{
    ViewData["Title"] = "Delete Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cd-page-header">
    <div>
        <h1>Delete Category</h1>
        <p>This action cannot be undone</p>
    </div>
    <a asp-action="Index" class="btn-secondary">← Back</a>
</div>

<div class="cd-card" style="max-width:400px;">
    <div class="cd-alert cd-alert-danger">
        Are you sure you want to delete <strong>@Model.Name</strong>?
        @if (Model.MenuItems.Any())
        {
            <div style="margin-top:8px;">
                 This category has <strong>@Model.MenuItems.Count()</strong> menu items linked to it.
                You must reassign or delete them first.
            </div>
        }
    </div>
    <div style="font-size:13.5px;color:var(--gray-600);margin-bottom:20px;">
        <div><strong>Name:</strong> @Model.Name</div>
        <div><strong>Items:</strong> @Model.MenuItems.Count() menu items</div>
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CategoryId" />
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-danger" @(Model.MenuItems.Any() ? "disabled" : "")>
                Yes, Delete
            </button>
            <a asp-action="Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
