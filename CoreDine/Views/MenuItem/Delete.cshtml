@model CoreDine.ViewModels.MenuItemViewModel
@{
    ViewData["Title"] = "Delete Menu Item";
}

<div class="cd-page-header">
    <div>
        <h1>Delete Item</h1>
        <p>This action cannot be undone</p>
    </div>
    <a asp-action="Index" class="btn-secondary">← Back</a>
</div>

<div class="cd-card" style="max-width:480px;">
    <div class="cd-alert cd-alert-danger" style="margin-bottom:20px;">
        Are you sure you want to delete <strong>@Model.Name</strong>?
    </div>
    <div style="font-size:13.5px;color:var(--gray-600);margin-bottom:20px;">
        <div><strong>Name:</strong> @Model.Name</div>
        <div><strong>Description:</strong> @Model.Description</div>
        <div><strong>Price:</strong> $@Model.Price.ToString("F2")</div>
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MenuItemId" />
        <div style="display:flex;gap:8px;">
            <button type="submit" class="btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn-secondary">Cancel</a>
        </div>
    </form>
</div>
