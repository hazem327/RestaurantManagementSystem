@model IEnumerable<CoreDine.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "All Orders";
}

<div class="cd-page-header">
    <div>
        <h1>All Orders</h1>
        <p>@Model.Count() total orders</p>
    </div>
</div>

<div class="cd-table-wrap">
    <div class="cd-card" style="margin-bottom:20px;">
        <form method="get" asp-action="Index" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
            <div class="cd-form-group" style="margin:0;">
                <label class="cd-form-label">Filter by Status</label>
                <select name="status" class="cd-form-control" style="width:180px;">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetValues<CoreDine.Models.OrderStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="cd-form-group" style="margin:0;">
                <label class="cd-form-label">Filter by Date</label>
                <input type="date" name="date" class="cd-form-control" style="width:180px;" />
            </div>
            <button type="submit" class="btn-primary">Apply</button>
            <a asp-action="Index" class="btn-secondary">Clear</a>
        </form>
    </div>
    <table class="cd-table">
        <thead>
            <tr>
                <th>Order</th>
                <th>Table</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong>#@order.OrderId</strong> — @order.OrderName</td>
                    <td>Table @order.TableNumber</td>
                    <td>@order.DateCreated.ToString("MMM d, h:mm tt")</td>
                    <td>$@order.TotalAmount.ToString("F2")</td>
                    <td>
                        <span class="badge-@order.Status.ToString().ToLower()">@order.Status</span>
                    </td>
                    <td style="display:flex;gap:6px;">
                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn-secondary btn-sm">View</a>
                        <form asp-action="Delete" asp-route-id="@order.OrderId" method="post"
                              onsubmit="return confirm('Delete this order?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
