@model CoreDine.ViewModels.UpdateOrderStatusViewModel
@{
    ViewData["Title"] = "Update Order Status";
}

<div class="cd-page-header">
    <div>
        <h1>Update Status</h1>
        <p>@Model.OrderName</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn-secondary">← Back</a>
</div>

<div class="cd-card" style="max-width:400px;">
    <form asp-action="UpdateStatus" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="OrderName" />

        <div class="cd-form-group">
            <label class="cd-form-label">New Status</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<CoreDine.Models.OrderStatus>()" class="cd-form-control"></select>
        </div>
        <button type="submit" class="btn-primary">Save Status</button>
    </form>
</div>
